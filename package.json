{
  "name": "ai-cad",
  "version": "0.2.0",
  "description": "Open-source AI-driven parametric CAD platform with NLP input and STEP export",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "biome check src && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check src",
    "lint:fix": "biome check src --write",
    "format": "biome format src --write",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "mcp:server": "bun run src/lib/mcp/server.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@monaco-editor/react": "^4.6.0",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-query-devtools": "^5.60.0",
    "@tanstack/react-router": "^1.90.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "dxf-parser": "^1.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "replicad": "^0.21.0",
    "replicad-opencascadejs": "^0.21.0",
    "tailwind-merge": "^2.5.0",
    "three": "^0.170.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tanstack/router-devtools": "^1.90.0",
    "@tanstack/router-plugin": "^1.90.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
