# Authentication (Optional - Azure AD)
# Leave blank to run without authentication
VITE_AZURE_AD_CLIENT_ID=
VITE_AZURE_AD_TENANT_ID=

# Backend Services (Optional - for full pipeline)
# Point these to your own instances, or leave blank for offline-only mode
VITE_LLM_GATEWAY_URL=http://localhost:8092
VITE_CAD_SERVICE_URL=http://localhost:8090
VITE_FILE_SERVER_URL=http://localhost:8091

# Universal Parts Consciousness (Optional)
VITE_UPC_URL=http://localhost:8093

# App version
VITE_APP_VERSION=0.1.0

# LLM Provider (openai | anthropic | ollama)
VITE_LLM_PROVIDER=openai
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=
